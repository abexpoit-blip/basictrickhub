{
  "manifest_version": 3,
  "name": "Basictrick Post Booster",
  "version": "5.2",
  "description": "Basictrick FB Post Booster — hex neon UI, 7-day Telegram license",
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "cookies",
    "tabs",
    "scripting",
    "proxy",
    "alarms",
    "webRequest",
    "webRequestAuthProvider",
    "sidePanel"
  ],
  "host_permissions": [
    "https://basictrickhub.com/*",
    "https://jsi-boost-tools-default-rtdb.asia-southeast1.firebasedatabase.app/*",
    "https://graph.facebook.com/*",
    "https://*.facebook.com/*",
    "http://ip-api.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Basictrick Post Booster",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
